# ---- Local development environment ----
# NEVER commit this file. Rotate every secret before going to production.

DATABASE_URL="<generated>"

# 64-char hex secret used to sign session JWTs. Regenerate for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="<generated>"

# Server-side salt for hashing IPs in audit/rate-limit tables (privacy).
IP_HASH_SALT="<generated>"

NEXT_PUBLIC_SITE_URL="<generated>"
NEXT_PUBLIC_SITE_NAME="<generated>"

# ---- Seeding (npm run seed) ----
# Password for the admin accounts the seed creates. Used only when an admin
# account does not exist yet; existing passwords are never overwritten.
# Min 10 chars with upper case, lower case and a number.
SEED_ADMIN_PASSWORD="<choose-a-strong-password>"
# Optional: fixed password for the demo shopper accounts (development only).
# If unset, a random one is generated and printed by the seed.
# SEED_DEMO_PASSWORD=""
# The seed refuses to run when NODE_ENV=production unless this is "true".
# SEED_ALLOW_PRODUCTION="false"
