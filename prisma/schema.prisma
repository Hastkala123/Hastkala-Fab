// Hastkala Fab — data model (PostgreSQL)
//
// Designed in docs/phase-1/04-data-model.md. Ground rules:
//   • Money is always an Int in paise. Tax rates are Int basis points (500 = 5%).
//   • Stock lives ONLY on ProductVariant. Every product has at least one variant.
//   • Orders, invoices and credit notes are snapshots: later edits to products,
//     addresses or settings never rewrite history.
//   • Every business value the owner might change lives in Setting / CMS tables
//     and is editable from the admin panel — nothing is hard-coded.
//   • Users are never hard-deleted (tax records must be kept); DPDP erasure
//     anonymises personal fields instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

