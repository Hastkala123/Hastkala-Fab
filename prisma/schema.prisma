// ===========================================================================
// Identity, staff & access
// ===========================================================================

model User {
  id              String       @id @default(cuid())
  /// At least one of email / phone is required (enforced in the service layer).
  email           String?      @unique
  /// E.164, e.g. +919876543210 — normalised before storage (fixes M10).
  phone           String?      @unique
  name            String
  /// Null for OTP-only or Google-only accounts.
  passwordHash    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          UserStatus   @default(ACTIVE)
  /// Becomes WHOLESALE only when the WholesaleProfile is APPROVED.
  customerType    CustomerType @default(RETAIL)

  // Staff -----------------------------------------------------------------
  isStaff            Boolean    @default(false)
  /// The owner account(s). Cannot be demoted or blocked from the admin UI.
  isOwner            Boolean    @default(false)
  staffRoleId        String?
  staffRole          StaffRole? @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  /// AES-256-GCM encrypted TOTP secret. Mandatory for staff.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  recoveryCodeHashes String[]

  // Brute-force protection -------------------------------------------------
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// DPDP erasure: personal fields are anonymised, orders kept for tax law.
  anonymisedAt     DateTime?

  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  addresses         Address[]
  cart              Cart?
  wishlist          WishlistItem[]
  orders            Order[]
  reviews           Review[]
  wholesaleProfile  WholesaleProfile?
  couponRedemptions CouponRedemption[]
  returnRequests    ReturnRequest[]
  storeCredit       StoreCreditEntry[]
  notifications     NotificationLog[]
  consents          ConsentRecord[]
  backInStock       BackInStockRequest[]
  tickets           SupportTicket[]      @relation("CustomerTickets")
  assignedTickets   SupportTicket[]      @relation("AssignedTickets")
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isStaff])
  @@index([customerType])
  @@index([createdAt])
}

/// Editable by the owner in Admin → Staff. Permission keys are defined in
/// src/server/permissions.ts (e.g. "orders.manage", "refunds.issue").
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  /// Seeded roles (Manager, Catalog, Dispatch, Support, Accounts) can be
  /// edited but not deleted.
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  userAgent     String?
  ipHash        String?
  /// Staff sessions must pass TOTP before reaching the admin panel.
  mfaVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// One-time codes for login, sign-up, phone/email verification, password
/// reset and high-value COD confirmation. Never stores the raw code or the
/// raw phone/email.
model OtpChallenge {
  id              String     @id @default(cuid())
  purpose         OtpPurpose
  channel         OtpChannel
  /// sha256(salt + normalised phone/email)
  destinationHash String
  userId          String?
  codeHash        String
  attempts        Int        @default(0)
  maxAttempts     Int        @default(3)
  expiresAt       DateTime
  consumedAt      DateTime?
  ipHash          String?
  createdAt       DateTime   @default(now())

  @@index([destinationHash, purpose, createdAt])
  @@index([expiresAt])
}

// ===========================================================================
// Wholesale (B2B)
// ===========================================================================

model WholesaleProfile {
  id              String                @id @default(cuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  legalName       String?
  gstin           String?
  gstinVerifiedAt DateTime?
  /// "Boutique", "Retail shop", "Reseller", "Online seller", …
  businessType    String?
  city            String?
  state           String?
  status          WholesaleStatus       @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  priceTierId     String?
  priceTier       PriceTier?            @relation(fields: [priceTierId], references: [id], onDelete: SetNull)
  paymentTerms    WholesalePaymentTerms @default(PREPAID)
  /// For ADVANCE_BALANCE terms, e.g. 30 (%).
  advancePercent  Int?
  /// For CREDIT terms, in paise.
  creditLimit     Int?
  staffNotes      String?
  documents       WholesaleDocument[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([gstin])
}

/// Stored in a PRIVATE bucket; served only through short-lived signed URLs.
model WholesaleDocument {
  id         String           @id @default(cuid())
  profileId  String
  profile    WholesaleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind       WholesaleDocKind
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime         @default(now())

  @@index([profileId])
}

/// Customer groups for wholesale pricing ("Standard", "Gold", …). Exactly one
/// tier has isDefault = true and applies to approved buyers without a tier.
model PriceTier {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  isDefault   Boolean            @default(false)
  profiles    WholesaleProfile[]
  prices      WholesalePrice[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// Quantity breaks per product per tier, e.g. 10+ @ ₹420, 50+ @ ₹395.
/// Whether these include GST is a store setting (tax.wholesalePricesIncludeTax).
model WholesalePrice {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceTierId String
  priceTier   PriceTier @relation(fields: [priceTierId], references: [id], onDelete: Cascade)
  minQuantity Int
  unitPrice   Int

  @@unique([productId, priceTierId, minQuantity])
  @@index([productId])
}

/// Leads from the public /wholesale page (no account needed).
model WholesaleInquiry {
  id                   String        @id @default(cuid())
  name                 String
  phone                String
  email                String?
  businessName         String?
  city                 String?
  categoriesOfInterest String[]
  message              String?
  status               InquiryStatus @default(NEW)
  staffNotes           String?
  source               String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status, createdAt])
}

// ===========================================================================
// Addresses & pincodes
// ===========================================================================

model Address {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(HOME)
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  /// GST state code, e.g. "08" for Rajasthan. Drives CGST/SGST vs IGST.
  stateCode String
  pincode   String
  country   String       @default("IN")
  /// Optional business GSTIN for a B2B invoice to this address.
  gstin     String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

/// Pincode → city/state autofill plus cached courier serviceability.
model PincodeInfo {
  pincode       String    @id
  city          String
  district      String?
  state         String
  stateCode     String
  isServiceable Boolean?
  codAvailable  Boolean?
  estimatedDays Int?
  checkedAt     DateTime?
}

// ===========================================================================
// Catalogue
// ===========================================================================

model Category {
  id              String                @id @default(cuid())
  name            String
  /// Becomes a top-level URL (/kurtis), so reserved route names are rejected.
  slug            String                @unique
  /// 150–300 word SEO intro shown above the grid.
  description     String?
  /// Long copy / FAQs shown below the grid.
  bottomContent   String?
  imageUrl        String?
  bannerImageUrl  String?
  parentId        String?
  parent          Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]            @relation("CategoryTree")
  /// Drag-and-drop order in the menu and on the homepage.
  position        Int                   @default(0)
  isActive        Boolean               @default(true)
  showInMenu      Boolean               @default(true)
  /// Default HSN and size chart for new products in this category.
  hsnCodeId       String?
  hsnCode         HsnCode?              @relation(fields: [hsnCodeId], references: [id], onDelete: SetNull)
  sizeChartId     String?
  sizeChart       SizeChart?            @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  metaTitle       String?
  metaDescription String?
  products        Product[]
  attributes      AttributeDefinition[]
  coupons         CouponCategory[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([parentId, position])
}

/// Admin-defined product fields. categoryId = null means "every category"
/// (Fabric, Print style, Occasion, Colour family). Category-specific examples:
/// Saree length, Blouse piece, Thread count, Bedsheet size, Pillow covers,
/// Stitch type, Sleeve, Neck, Silhouette.
model AttributeDefinition {
  id                String                  @id @default(cuid())
  key               String                  @unique
  label             String
  type              AttributeType
  unit              String?
  options           String[]
  categoryId        String?
  category          Category?               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isFilterable      Boolean                 @default(false)
  isRequired        Boolean                 @default(false)
  showOnProductPage Boolean                 @default(true)
  position          Int                     @default(0)
  values            ProductAttributeValue[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([categoryId, position])
}

/// One row per value (MULTI_SELECT stores one row per selected option), so
/// filters are plain indexed lookups.
model ProductAttributeValue {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String
  numericValue Decimal?            @db.Decimal(10, 2)

  @@unique([productId, attributeId, value])
  @@index([attributeId, value])
  @@index([attributeId, numericValue])
}

model HsnCode {
  id          String     @id @default(cuid())
  code        String     @unique
  description String
  taxRules    TaxRule[]
  products    Product[]
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// GST rate by HSN and per-unit value band, with effective dates so a rate
/// change (like September 2025) is a new row, not a code change. Rates are
/// entered by the owner on their CA's advice.
model TaxRule {
  id            String    @id @default(cuid())
  hsnCodeId     String
  hsnCode       HsnCode   @relation(fields: [hsnCodeId], references: [id], onDelete: Cascade)
  /// Inclusive lower bound of the per-piece taxable value, in paise.
  minUnitValue  Int       @default(0)
  /// Inclusive upper bound; null = no limit.
  maxUnitValue  Int?
  /// 500 = 5.00 %
  rateBps       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([hsnCodeId, effectiveFrom])
}

model SizeChart {
  id         String     @id @default(cuid())
  name       String
  unit       String     @default("in")
  columns    String[]
  /// [{ "size": "M", "values": ["38", "40", "44"] }, …]
  rows       Json
  notes      String?
  imageUrl   String?
  categories Category[]
  products   Product[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String?
  /// Sanitised rich text (allow-listed HTML).
  description      String
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status           ProductStatus  @default(DRAFT)
  /// Scheduled publishing: ACTIVE products appear only once publishAt has passed.
  publishAt        DateTime?
  printTechnique   PrintTechnique
  hsnCodeId        String?
  hsnCode          HsnCode?       @relation(fields: [hsnCodeId], references: [id], onDelete: SetNull)
  sizeChartId      String?
  sizeChart        SizeChart?     @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  /// Paise, inclusive of all taxes (Legal Metrology).
  mrp              Int
  /// Retail selling price, paise, inclusive of GST. Variants may override.
  price            Int
  wholesaleEnabled Boolean @default(false)
  /// Minimum units per wholesale order line.
  wholesaleMinQty  Int     @default(1)

  /// Packed shipping weight and box size (courier rates, labels).
  weightGrams      Int?
  lengthCm         Int?
  widthCm          Int?
  heightCm         Int?
  countryOfOrigin  String  @default("India")
  careInstructions String?
  isReturnable     Boolean @default(true)
  isCodAllowed     Boolean @default(true)
  isFeatured       Boolean @default(false)
  isNewArrival     Boolean @default(false)
  /// Manual drag-and-drop order within its category.
  position         Int     @default(0)

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  /// Extra internal-search terms ("chadar", "suit piece", Hindi spellings).
  searchKeywords  String[]

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)
  soldCount   Int   @default(0)

  media           ProductMedia[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  wholesalePrices WholesalePrice[]
  collections     CollectionProduct[]
  reviews         Review[]
  wishlistedBy    WishlistItem[]
  orderItems      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status, position])
  @@index([status, isFeatured])
  @@index([status, price])
  @@index([status, createdAt])
  @@index([status, soldCount])
  /// Typo-tolerant search (requires the pg_trgm extension; see migration notes).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([searchKeywords], type: Gin)
}

/// The ONLY place stock lives (fixes H1). A product without sizes/colours has
/// one variant with size = null and colorName = null.
model ProductVariant {
  id                 String               @id @default(cuid())
  productId          String
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String               @unique
  size               String?
  colorName          String?
  colorHex           String?
  /// Pieces per unit — e.g. 5 for a wholesale "set of 5 sizes (S–XXL)".
  packQuantity       Int                  @default(1)
  /// Display label override, e.g. "Set of 5 (S–XXL)". Defaults to size / colour.
  label              String?
  /// Optional overrides of the product's price / MRP, in paise.
  price              Int?
  mrp                Int?
  /// Never negative (CHECK constraint added in the migration).
  stock              Int                  @default(0)
  lowStockThreshold  Int                  @default(3)
  weightGrams        Int?
  barcode            String?
  position           Int                  @default(0)
  isActive           Boolean              @default(true)
  /// Set instead of deleting once a variant has order history (fixes H11).
  archivedAt         DateTime?
  media              ProductMedia[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  backInStock        BackInStockRequest[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([productId, position])
  @@index([stock])
}

model ProductMedia {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Colour-specific photos switch when that colour is selected.
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type       MediaType       @default(IMAGE)
  url        String
  storageKey String
  alt        String
  width      Int?
  height     Int?
  position   Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([productId, position])
}

/// Every stock change, with a reason — the answer to "where did 3 pieces go?".
model InventoryMovement {
  id              String          @id @default(cuid())
  variantId       String
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  change          Int
  stockAfter      Int
  reason          InventoryReason
  note            String?
  orderId         String?
  returnRequestId String?
  actorId         String?
  createdAt       DateTime        @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

/// Curated landing pages ("Jaipuri King Size Bedsheets", "Summer Mulmul
/// Sarees") — the main tool for ranking on many keywords.
model Collection {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?
  bottomContent   String?
  heroImageUrl    String?
  isActive        Boolean             @default(true)
  showOnHome      Boolean             @default(false)
  position        Int                 @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  metaTitle       String?
  metaDescription String?
  products        CollectionProduct[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@id([collectionId, productId])
  @@index([productId])
}

/// Admin-editable search synonyms: "chadar" → ["bedsheet", "bed sheet"].
model SearchSynonym {
  id        String   @id @default(cuid())
  term      String   @unique
  synonyms  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Links the review to the delivered line that proves the purchase.
  orderItemId        String?
  rating             Int
  title              String?
  body               String
  status             ReviewStatus  @default(PENDING)
  rejectionReason    String?
  isVerifiedPurchase Boolean       @default(false)
  media              ReviewMedia[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

model ReviewMedia {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([reviewId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model BackInStockRequest {
  id         String              @id @default(cuid())
  variantId  String
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?
  phone      String?
  channel    NotificationChannel
  notifiedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([variantId, notifiedAt])
}

// ===========================================================================
// Cart & coupons
// ===========================================================================

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the opaque guest cookie value.
  guestTokenHash String?    @unique
  couponCode     String?
  giftWrap       Boolean    @default(false)
  giftMessage    String?
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id            String         @id @default(cuid())
  cartId        String
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity      Int
  savedForLater Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  /// variantId is never null now, so this really prevents duplicates (fixes L4).
  @@unique([cartId, variantId])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  description    String?
  type           CouponType
  /// Whole-number percent for PERCENT; paise for FLAT; ignored for FREE_SHIPPING.
  value          Int
  maxDiscount    Int?
  minOrderValue  Int                @default(0)
  audience       Audience           @default(ALL)
  firstOrderOnly Boolean            @default(false)
  usageLimit     Int?
  /// Incremented with a conditional update inside the checkout transaction (fixes H3).
  usedCount      Int                @default(0)
  perUserLimit   Int                @default(1)
  /// Stored in UTC; the admin form works in IST and "ends on 31 Oct" means 23:59:59 IST (fixes M3).
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  isActive       Boolean            @default(true)
  categories     CouponCategory[]
  redemptions    CouponRedemption[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

/// Empty = coupon applies to every category.
model CouponCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponRedemption {
  id         String    @id @default(cuid())
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount   Int
  /// Set when the order is cancelled, so the use no longer counts.
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([couponId, userId])
}

// ===========================================================================
// Orders
// ===========================================================================

/// Gap-free counters for human-facing numbers. Incremented inside the same
/// transaction that creates the document, so a rollback never burns a number
/// (fixes H4 and the invoice-gap requirement).
/// Keys: "order", "invoice:2026-27", "creditnote:2026-27", "return", "refund", "ticket".
model DocumentSequence {
  key       String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Order {
  id             String       @id @default(cuid())
  /// HF-100001 — readable on a phone call.
  orderNumber    String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  channel        OrderChannel @default(WEB)
  customerType   CustomerType
  /// Staff member who created a manual (phone / WhatsApp) order.
  createdById    String?
  /// Sent by the checkout page; a retried or double-clicked "Place order"
  /// returns the existing order instead of creating a second one.
  idempotencyKey String?      @unique

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod
  /// Unpaid prepaid orders are cancelled and their stock released after this (fixes C3).
  paymentDueBy  DateTime?

  // Snapshots ----------------------------------------------------------------
  shippingAddress        Json
  billingAddress         Json
  contactEmail           String?
  contactPhone           String
  buyerGstin             String?
  buyerBusinessName      String?
  /// Delivery state's GST code; the seller is in Rajasthan ("08").
  placeOfSupplyStateCode String
  taxType                TaxType

  // Money (paise) -----------------------------------------------------------
  /// true for retail (prices shown include GST); wholesale per store setting.
  pricesIncludeTax Boolean
  /// Σ line subtotals before the order-level discount, as displayed.
  itemsSubtotal    Int
  discountTotal    Int     @default(0)
  shippingFee      Int     @default(0)
  codFee           Int     @default(0)
  giftWrapFee      Int     @default(0)
  taxableValue     Int
  cgstTotal        Int     @default(0)
  sgstTotal        Int     @default(0)
  igstTotal        Int     @default(0)
  roundOff         Int     @default(0)
  grandTotal       Int
  amountPaid       Int     @default(0)
  amountRefunded   Int     @default(0)

  couponCode    String?
  customerNote  String?
  giftMessage   String?
  staffNote     String?
  cancelReason  String?
  cancelledById String?

  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payments         Payment[]
  invoices         Invoice[]
  creditNotes      CreditNote[]
  shipments        Shipment[]
  returnRequests   ReturnRequest[]
  refunds          Refund[]
  couponRedemption CouponRedemption?
  tickets          SupportTicket[]

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([userId, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus, placedAt])
  @@index([paymentDueBy])
  @@index([placedAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot -----------------------------------------------------------------
  title          String
  sku            String
  variantLabel   String?
  imageUrl       String?
  hsnCode        String
  printTechnique PrintTechnique
  packQuantity   Int            @default(1)

  // Money (paise) -----------------------------------------------------------
  unitPrice         Int
  quantity          Int
  /// unitPrice × quantity
  lineSubtotal      Int
  /// Share of the order-level coupon discount.
  discountAllocated Int @default(0)
  taxableValue      Int
  taxRateBps        Int
  cgst              Int @default(0)
  sgst              Int @default(0)
  igst              Int @default(0)
  /// What the customer pays for this line.
  lineTotal         Int

  quantityShipped   Int @default(0)
  quantityReturned  Int @default(0)
  quantityCancelled Int @default(0)

  returnItems   ReturnItem[]
  shipmentItems ShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

/// The customer's tracking timeline and the staff audit trail in one place.
model OrderStatusHistory {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  note              String?
  isCustomerVisible Boolean      @default(true)
  actorType         ActorType
  actorId           String?
  createdAt         DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ===========================================================================
// Payments
// ===========================================================================

model Payment {
  id                String               @id @default(cuid())
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  method            PaymentMethod?
  status            PaymentAttemptStatus @default(CREATED)
  amount            Int
  amountRefunded    Int                  @default(0)
  currency          String               @default("INR")
  /// Razorpay order_… id
  providerOrderId   String?              @unique
  /// Razorpay pay_… id
  providerPaymentId String?              @unique
  idempotencyKey    String               @unique
  failureCode       String?
  failureReason     String?
  /// UTR / reference for bank transfers, verified by Accounts staff.
  manualReference   String?
  verifiedById      String?
  capturedAt        DateTime?
  refunds           Refund[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

/// Raw inbound webhooks (Razorpay, Shiprocket). The unique key makes replays
/// and duplicate deliveries harmless.
model WebhookEvent {
  id             String    @id @default(cuid())
  provider       String
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  attempts       Int       @default(0)
  error          String?

  @@unique([provider, eventId])
  @@index([processedAt])
}

// ===========================================================================
// GST invoices & credit notes
// ===========================================================================

model Invoice {
  id             String        @id @default(cuid())
  /// HF/26-27/000123 — consecutive per financial year, max 16 characters.
  invoiceNumber  String        @unique
  financialYear  String
  sequence       Int
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status         InvoiceStatus @default(ISSUED)
  issuedAt       DateTime      @default(now())
  /// Seller legal name, GSTIN, address, state code at the moment of issue.
  sellerSnapshot Json
  buyerSnapshot  Json
  /// Per line: description, HSN, qty, unit price, discount, taxable, rate, CGST, SGST, IGST, total.
  lines          Json
  taxableValue   Int
  cgstTotal      Int
  sgstTotal      Int
  igstTotal      Int
  roundOff       Int
  grandTotal     Int
  pdfStorageKey  String?
  // Optional e-invoicing module (depends on turnover) ------------------------
  irn            String?
  ackNumber      String?
  ackDate        DateTime?
  signedQrCode   String?
  cancelledAt    DateTime?
  cancelReason   String?
  creditNotes    CreditNote[]
  createdAt      DateTime      @default(now())

  @@unique([financialYear, sequence])
  @@index([orderId])
  @@index([issuedAt])
}

model CreditNote {
  id               String   @id @default(cuid())
  /// HFCN/26-27/00012 — its own consecutive series.
  creditNoteNumber String   @unique
  financialYear    String
  sequence         Int
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refundId         String?  @unique
  refund           Refund?  @relation(fields: [refundId], references: [id], onDelete: SetNull)
  returnRequestId  String?
  reason           String
  lines            Json
  taxableValue     Int
  cgstTotal        Int
  sgstTotal        Int
  igstTotal        Int
  grandTotal       Int
  pdfStorageKey    String?
  issuedAt         DateTime @default(now())

  @@unique([financialYear, sequence])
  @@index([orderId])
}

// ===========================================================================
// Shipping & tracking
// ===========================================================================

model Shipment {
  id                 String            @id @default(cuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// REVERSE = return pickup.
  direction          ShipmentDirection @default(FORWARD)
  returnRequestId    String?
  returnRequest      ReturnRequest?    @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  provider           ShippingProvider
  providerOrderId    String?
  providerShipmentId String?
  awb                String?           @unique
  courierName        String?
  trackingUrl        String?
  labelUrl           String?
  manifestUrl        String?
  status             ShipmentStatus    @default(CREATED)
  weightGrams        Int?
  lengthCm           Int?
  widthCm            Int?
  heightCm           Int?
  /// Amount the courier collects on delivery (COD), in paise.
  codAmount          Int               @default(0)
  expectedDeliveryAt DateTime?
  pickupScheduledAt  DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  ndrReason          String?
  ndrAttempts        Int               @default(0)
  lastSyncedAt       DateTime?
  createdById        String?
  items              ShipmentItem[]
  events             ShipmentEvent[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([orderId])
  @@index([status, updatedAt])
}

/// Which order lines (and how many) are in this parcel — enables partial shipments.
model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int

  @@unique([shipmentId, orderItemId])
}

model ShipmentEvent {
  id             String         @id @default(cuid())
  shipmentId     String
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status         ShipmentStatus
  /// Courier's own wording, shown in the timeline.
  providerStatus String?
  location       String?
  description    String?
  occurredAt     DateTime
  source         TrackingSource
  /// hash(shipment, time, providerStatus) — the same scan never appears twice.
  dedupeKey      String         @unique
  createdAt      DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

// ===========================================================================
// Returns, refunds & store credit
// ===========================================================================

model ReturnRequest {
  id              String        @id @default(cuid())
  /// RET-100001
  returnNumber    String        @unique
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  type            ReturnType
  status          ReturnStatus  @default(REQUESTED)
  reason          String
  customerNote    String?
  staffNote       String?
  rejectionReason String?
  refundMethod    RefundMethod?
  pickupAddress   Json
  /// Replacement order created for an exchange.
  exchangeOrderId String?
  reviewedById    String?
  items           ReturnItem[]
  photos          ReturnPhoto[]
  shipments       Shipment[]
  refunds         Refund[]
  requestedAt     DateTime      @default(now())
  approvedAt      DateTime?
  receivedAt      DateTime?
  closedAt        DateTime?
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status, requestedAt])
}

model ReturnItem {
  id                String        @id @default(cuid())
  returnRequestId   String
  returnRequest     ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId       String
  orderItem         OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity          Int
  reason            String?
  /// Requested replacement size / colour for an exchange.
  exchangeVariantId String?
  /// Stock goes back on sale only after QC passes (fixes H8).
  qcResult          QcResult      @default(PENDING)
  qcNote            String?
  restockedAt       DateTime?

  @@unique([returnRequestId, orderItemId])
}

model ReturnPhoto {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  url             String
  storageKey      String
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
}

model Refund {
  id                  String            @id @default(cuid())
  /// RFD-100001
  refundNumber        String            @unique
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId           String?
  payment             Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequestId     String?
  returnRequest       ReturnRequest?    @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  /// Never more than the amount paid minus earlier refunds (checked in a transaction).
  amount              Int
  method              RefundMethod
  status              RefundStatus      @default(INITIATED)
  reason              String
  providerRefundId    String?           @unique
  idempotencyKey      String            @unique
  /// AES-256-GCM encrypted bank / UPI details for COD refunds.
  payoutDetailsEnc    String?
  /// e.g. "UPI ••••@okhdfc" — safe to display.
  payoutDetailsMasked String?
  failureReason       String?
  initiatedById       String?
  processedAt         DateTime?
  creditNote          CreditNote?
  storeCreditEntry    StoreCreditEntry?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

/// Append-only ledger; balance = latest balanceAfter.
model StoreCreditEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// + credit / − debit, in paise.
  amount       Int
  balanceAfter Int
  reason       String
  orderId      String?
  refundId     String?   @unique
  refund       Refund?   @relation(fields: [refundId], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
}

// ===========================================================================
// Notifications, consent & background jobs
// ===========================================================================

/// Admin-editable message text for every event × channel.
/// Events: account.welcome, otp, order.placed, payment.failed, order.confirmed,
/// order.packed, order.shipped, order.out_for_delivery, order.delivered,
/// order.ndr, order.cancelled, return.*, refund.*, wholesale.approved, …
model NotificationTemplate {
  id                 String              @id @default(cuid())
  event              String
  channel            NotificationChannel
  subject            String?
  /// Text with {{placeholders}}.
  body               String
  /// WhatsApp-approved / DLT-registered template id.
  providerTemplateId String?
  isActive           Boolean             @default(true)
  updatedAt          DateTime            @updatedAt

  @@unique([event, channel])
}

model NotificationLog {
  id                String              @id @default(cuid())
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId           String?
  event             String
  channel           NotificationChannel
  recipientMasked   String
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// DPDP Act, 2023 consent trail. The latest row per (user, purpose) wins.
model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Hash of the anonymous cookie id for visitors who are not signed in.
  subjectHash   String?
  purpose       ConsentPurpose
  granted       Boolean
  /// "signup_form", "cookie_banner", "account_settings", …
  source        String
  noticeVersion String
  ipHash        String?
  createdAt     DateTime       @default(now())

  @@index([userId, purpose, createdAt])
  @@index([subjectHash, purpose, createdAt])
}

/// Durable background work, run by a cron-triggered worker route:
/// notifications, expiring unpaid orders, tracking sync, payment
/// reconciliation, invoice PDFs, abandoned-cart and back-in-stock messages.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, runAt])
}

// ===========================================================================
// Support
// ===========================================================================

model SupportTicket {
  id           String          @id @default(cuid())
  /// TKT-100001
  ticketNumber String          @unique
  userId       String?
  user         User?           @relation("CustomerTickets", fields: [userId], references: [id], onDelete: SetNull)
  guestName    String?
  guestEmail   String?
  guestPhone   String?
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject      String
  category     TicketCategory  @default(OTHER)
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(NORMAL)
  assignedToId String?
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  closedAt     DateTime?

  @@index([userId])
  @@index([status, priority, updatedAt])
  @@index([assignedToId])
}

model TicketMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  ActorType
  authorId    String?
  authorName  String
  body        String
  /// Staff-only note, never shown to the customer.
  isInternal  Boolean            @default(false)
  attachments TicketAttachment[]
  createdAt   DateTime           @default(now())

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id         String        @id @default(cuid())
  messageId  String
  message    TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime      @default(now())

  @@index([messageId])
}

// ===========================================================================
// Website content (all editable in Admin → Content)
// ===========================================================================

/// Terms, Privacy, Shipping, Returns, About, Our Craft, Contact, Grievance…
model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  type            PageType
  body            String
  status          ContentStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  showInFooter    Boolean       @default(false)
  position        Int           @default(0)
  publishedAt     DateTime?
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Banner {
  id              String          @id @default(cuid())
  placement       BannerPlacement
  title           String?
  subtitle        String?
  imageUrl        String?
  mobileImageUrl  String?
  linkUrl         String?
  ctaLabel        String?
  backgroundColor String?
  audience        Audience        @default(ALL)
  position        Int             @default(0)
  isActive        Boolean         @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([placement, isActive, position])
}

/// Homepage built from drag-and-drop sections.
model HomeSection {
  id        String          @id @default(cuid())
  type      HomeSectionType
  title     String?
  subtitle  String?
  /// Section settings, e.g. { "collectionId": "…", "limit": 8 }.
  config    Json
  position  Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, position])
}

model Faq {
  id         String   @id @default(cuid())
  question   String
  answer     String
  /// "Orders", "Shipping", "Returns", "Wholesale", "Fabric care", …
  group      String   @default("General")
  /// Where else it appears: "category:kurtis", "wholesale", "product:sarees".
  placements String[]
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([group, position])
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  body            String
  coverImageUrl   String?
  authorName      String
  tags            String[]
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Typed store settings, each validated by a Zod schema in code and edited in
/// Admin → Settings. Keys: store.profile, shipping, cod, returns, tax,
/// wholesale, checkout, notifications, seo, social.
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           NewsletterStatus @default(PENDING)
  confirmTokenHash String?
  source           String?
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
}

/// Immutable record of every staff and money-related action.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Email / name at the time — survives later account changes.
  actorLabel String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Fixed-window rate-limit counters, incremented atomically with
/// INSERT … ON CONFLICT … RETURNING (fixes H9). Expired rows are pruned by a job.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
